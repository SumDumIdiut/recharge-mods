<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ExampleMod</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateDependencyFile>False</GenerateDependencyFile>
  </PropertyGroup>

  <!--
    $(ManagedDir) is passed in by build-loader.ps1 (-p:ManagedDir=...) - it
    points at the game's own IGTAPsnfDemo_Data\Managed folder, which is where
    every one of these DLLs actually lives (both real Unity/game assemblies,
    and Recharge.ModApi.dll, which the loader build copies there in phase 1).
    Add more <Reference> entries the same way if your mod needs another
    Unity module (e.g. UnityEngine.TilemapModule, UnityEngine.UI, DOTween) -
    see docs/creating-a-mod.md for how to find the right module for a type.
  -->
  <ItemGroup>
    <Reference Include="Recharge.ModApi"><HintPath>$(ManagedDir)\Recharge.ModApi.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
